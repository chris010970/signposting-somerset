# Signposting Somerset: files Git should ignore.

# Build outputs (made by the scripts in build/). Copy what you need into docs/ and src/ instead of committing these.
build/directory/github/
build/tools/out/
build/places/out/
build/next/github/

# Python
__pycache__/
*.pyc

# Never commit secrets (the Assist access code and API key live only in Cloudflare)
.env
*.env
*secret*
*.key

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

build/tests/node_modules/
checks/
monitor-*
*.zip
